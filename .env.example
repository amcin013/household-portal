# Copy to .env and fill in.  Never commit the real .env.

# Long random string. Generate with:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the SQLite database lives. Default is instance/portal.db next to the app.
# DATABASE_URL=sqlite:////var/lib/household-portal/portal.db

# --- Google sign-in -------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI: https://portal.example.com/auth/callback
# Leave these blank to run in local-only mode (see AUTH_MODE below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who is allowed in. Comma-separated Google account emails.
# The first person to sign in becomes an admin; after that, admins invite
# people from Settings -> People.
ALLOWED_EMAILS=allen.mcintosh@gmail.com

# open   - anyone on the allowlist can sign in with Google (normal setting)
# local  - no Google needed; a single local password login (handy on a LAN
#          box before you set OAuth up). Set LOCAL_PASSWORD below.
AUTH_MODE=open
LOCAL_PASSWORD=

# --- Weather --------------------------------------------------------------
# NOAA/NWS asks for a contact string in the User-Agent. No API key needed.
NWS_USER_AGENT=household-portal (allen.mcintosh@gmail.com)

# --- Server ---------------------------------------------------------------
# Set to 1 when running behind nginx/Caddy so secure cookies and real client
# IPs work correctly.
BEHIND_PROXY=0
