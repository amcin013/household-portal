# systemd unit for the household portal.
#
#   sudo cp deploy/household-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now household-portal
#
# Check on it with:  systemctl status household-portal
# Read the log with: journalctl -u household-portal -f

[Unit]
Description=Household Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The user the service runs as. Create it with:
#   sudo useradd --system --home /opt/household-portal --shell /usr/sbin/nologin portal
User=portal
Group=portal

WorkingDirectory=/opt/household-portal

# /usr/bin and /bin are on the path because the VM page shells out to virsh
# and ssh. A venv-only PATH makes the portal report "virsh is not installed"
# on a box where it plainly is.
Environment="PATH=/opt/household-portal/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# ssh looks in $HOME for the key and known_hosts it needs to reach a remote
# hypervisor, and systemd does not set one. Without this a qemu+ssh:// URI
# fails with a bare "Permission denied" that reads like a libvirt problem.
Environment="HOME=/opt/household-portal"

EnvironmentFile=/opt/household-portal/.env

# Binds to every interface so the portal is reachable from other machines on
# the house network. That is the normal case here: a home server on a LAN, no
# reverse proxy. Loopback-only (127.0.0.1:8000) is the right choice ONLY when
# nginx or Caddy sits in front - see deploy/nginx.conf.example - and the
# symptom of getting it wrong is the portal working on the server itself and
# refusing every other machine.
ExecStart=/opt/household-portal/.venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8000 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=5

# The database, and - if the VM page talks to a remote hypervisor - the ssh
# control socket. Nothing else needs writing to.
ReadWritePaths=/opt/household-portal/instance
ReadWritePaths=-/opt/household-portal/.ssh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
